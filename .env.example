# Copy to `.env` for local overrides. Local defaults already let the app boot with
# no setup — you only need these to change behaviour. Production values are set on Render.

# Debug mode. Keep true locally; MUST be false in production.
DEBUG=true

# Secret key. A dev fallback is baked in; production generates its own on Render.
SECRET_KEY=dev-insecure-key-do-not-use-in-prod

# Comma-separated hostnames Django will serve.
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Log level for everything (DEBUG/INFO/WARNING/ERROR). Output goes to stderr, which is what
# the host captures — Render shows it under the service's Logs tab. See docs/infrastructure.md.
# LOG_LEVEL=INFO

# Comma-separated origins allowed to call this API (the frontend).
CORS_ALLOWED_ORIGINS=http://localhost:4321,https://souhaibbenfarhat.github.io

# Database. Leave unset locally to use SQLite. In production this is a Postgres URL
# (set on Render). Example: postgres://user:pass@host:5432/dbname
# DATABASE_URL=

# --- AI chat ---------------------------------------------------------------
# The failover chain lives in the admin under "Chat models": drag the rows to choose
# which model answers (the top one) and the order the rest are tried in. These two vars
# are only the fallback for when that list is empty — a fresh deploy, or a wiped free
# database — so the chat still works before anything is configured. The provider prefix
# selects which key below is used.
CHAT_MODEL=mistral/mistral-small-latest
CHAT_FALLBACK_MODEL=mistral/open-mistral-nemo
# Sampling temperature — higher is more varied/conversational (0.0–1.0+).
CHAT_TEMPERATURE=0.7

# Free provider API keys. Mistral has a genuinely free tier that works in the EU
# (Gemini's free tier is limit:0 in the EEA). Get a key at console.mistral.ai.
# Groq (console.groq.com) is a free alternative. Set the real values on Render for
# production, or add them (encrypted) in the Django admin under "API credentials".
MISTRAL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Z.ai, for the GLM models. glm-4.7-flash is free (200k window, tool calling) and is
# seeded into the chain, switched off until this key exists. glm-5.2 is stronger but
# paid — add it as a row in the admin if you want it. Key: z.ai, no card required.
ZAI_API_KEY=

# GitHub, for the project/README tools. Username defaults to SouhaibBenFarhat.
# A token is optional (lifts the API rate limit); create a read-only one if needed.
GITHUB_USERNAME=SouhaibBenFarhat
GITHUB_TOKEN=

# Chat guardrails (optional — sensible defaults apply if unset).
# CHAT_MAX_MESSAGE_LENGTH=2000     # reject longer messages
# CHAT_MAX_HISTORY_MESSAGES=100    # how much history is sent to the model
# CHAT_RATE_LIMIT=10               # requests per IP per window
# CHAT_RATE_WINDOW_SECONDS=60      # the rate-limit window, in seconds

# Scope check — a cheap model call reads the visitor's message BEFORE the agent runs and
# refuses anything that isn't about Souhaib, so nobody can spend the free tier using the
# chat as a general assistant. Off-topic costs one short check, not a whole answer.
# See chat/guard.py.
# CHAT_GUARD_ENABLED=true          # off = every message is answered
# CHAT_GUARD_MODEL=mistral/mistral-small-latest  # the check's model (defaults to CHAT_MODEL)

# Follow-up chips — after each reply, a cheap model call writes up to 3 questions the
# visitor could ask next; the widget shows them as tappable chips. See chat/suggestions.py.
# CHAT_SUGGESTIONS_ENABLED=true    # off = no chips, nothing else changes
# CHAT_SUGGESTIONS_MODEL=mistral/mistral-small-latest  # the writer's model (defaults to CHAT_MODEL)

# --- Auth / social login (allauth) -----------------------------------------
# Social-login app credentials (Google / GitHub / LinkedIn) are NOT env vars — they're managed
# in the Django admin under "Social login apps", encrypted at rest (see core.models /
# core.adapter). Add one row per provider with its client id + secret from the provider's
# developer console; takes effect with no redeploy. docs/infrastructure.md has the app setup.
#
# Dashboard base URL — where allauth redirects the browser after a social round-trip.
# FRONTEND_URL=http://localhost:4321

# --- Email (verification codes + password reset) ---------------------------
# Transactional mail for the email+password flow. Leave EMAIL_HOST UNSET locally: the app
# falls back to Django's console backend, which prints the message — including the
# verification code — to the runserver output, so the whole sign-up flow is testable with no
# account and nothing sent. In production, point these at Brevo (EU, free tier) and use a
# sender verified on the hirees.me domain (SPF/DKIM). See docs/auth.md.
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=                       # Brevo SMTP login
# EMAIL_HOST_PASSWORD=                   # Brevo SMTP key (secret)
# DEFAULT_FROM_EMAIL=hirees.me <no-reply@hirees.me>

# --- Tenancy ---------------------------------------------------------------
# Every document, fact and conversation belongs to a user (see docs/tenancy.md).
#
# DEFAULT_TENANT_EMAIL decides WHICH account the ownership migration assigns all the
# existing rows to. Set it before that migration first runs: unset, it falls back to "the
# earliest superuser", which is often a preview or setup admin rather than the real owner.
# DEFAULT_TENANT_EMAIL=
#
# The handle that account gets — the souhaib in souhaib.hirees.me.
# DEFAULT_TENANT_HANDLE=souhaib
#
# Who a request that names no tenant is answered as. This is what keeps the Astro
# portfolio's chat working: it posts to the apex and names nobody. Set it empty once every
# visitor arrives through a tenant's own subdomain, and an unresolvable request 404s.
# FALLBACK_TENANT_HANDLE=souhaib
#
# The domain tenant subdomains hang off, so souhaib.hirees.me resolves to "souhaib".
# TENANT_BASE_DOMAIN=hirees.me
